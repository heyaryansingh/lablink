{
  "name": "lablink-cli",
  "version": "0.1.0-beta.4",
  "description": "Local-first terminal operating system for research labs",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heyaryansingh/lablink.git"
  },
  "bugs": {
    "url": "https://github.com/heyaryansingh/lablink/issues"
  },
  "homepage": "https://github.com/heyaryansingh/lablink#readme",
  "keywords": [
    "lab",
    "terminal",
    "cli",
    "research",
    "productivity",
    "ai",
    "meetings",
    "oauth"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "lablink": "bin/lablink.mjs"
  },
  "files": [
    "bin",
    "dist",
    "web",
    "src/db/migrations",
    "docs/product/PRD_V2_3_REAL_AI_ACTIONS.md",
    "docs/product/PRD_V2_4_WEB_PLATFORM.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "prepack": "npm run build",
    "build": "node bin/lablink.mjs build",
    "dev": "node bin/lablink.mjs demo",
    "demo": "node bin/lablink.mjs demo",
    "web": "node bin/lablink.mjs web",
    "web:smoke": "node bin/lablink.mjs web --smoke",
    "smoke": "node bin/lablink.mjs demo --snapshot --fresh",
    "init": "node bin/lablink.mjs init",
    "seed": "node bin/lablink.mjs seed",
    "sync": "node bin/lablink.mjs sync",
    "typecheck": "node bin/lablink.mjs check",
    "test": "node bin/lablink.mjs test",
    "lint": "node bin/lablink.mjs check",
    "validate": "node bin/lablink.mjs validate",
    "full:dev": "tsx src/cli.ts",
    "full:typecheck": "tsc --noEmit",
    "full:test": "vitest run",
    "full:build": "tsup",
    "pack:dry": "npm pack --dry-run",
    "release:check": "node scripts/release-check.mjs",
    "publish:beta": "npm publish --tag beta --access public"
  },
  "dependencies": {},
  "devDependencies": {},
  "lablinkFullStackDependencies": {
    "@anthropic-ai/sdk": "^0.66.0",
    "@azure/msal-node": "^2.16.3",
    "better-sqlite3": "^11.10.0",
    "commander": "^14.0.0",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.44.0",
    "googleapis": "^144.0.0",
    "ink": "^5.2.1",
    "openai": "^6.9.1",
    "react": "^18.3.1",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
