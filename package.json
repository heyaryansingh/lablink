{
  "name": "@lablink/cli",
  "version": "0.1.0",
  "description": "Local-first terminal operating system for research labs",
  "type": "module",
  "license": "MIT",
  "bin": {
    "lablink": "./bin/lablink.mjs"
  },
  "files": [
    "bin",
    "dist",
    "src/db/migrations",
    "docs/product",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "node bin/lablink.mjs build",
    "dev": "node bin/lablink.mjs demo",
    "demo": "node bin/lablink.mjs demo",
    "smoke": "node bin/lablink.mjs demo --snapshot",
    "init": "node bin/lablink.mjs init",
    "seed": "node bin/lablink.mjs seed",
    "sync": "node bin/lablink.mjs sync",
    "typecheck": "node bin/lablink.mjs check",
    "test": "node bin/lablink.mjs test",
    "lint": "node bin/lablink.mjs check",
    "validate": "node bin/lablink.mjs validate",
    "full:dev": "tsx src/cli.ts",
    "full:typecheck": "tsc --noEmit",
    "full:test": "vitest run",
    "full:build": "tsup"
  },
  "dependencies": {},
  "devDependencies": {},
  "lablinkFullStackDependencies": {
    "@anthropic-ai/sdk": "^0.66.0",
    "@azure/msal-node": "^2.16.3",
    "better-sqlite3": "^11.10.0",
    "commander": "^14.0.0",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.44.0",
    "googleapis": "^144.0.0",
    "ink": "^5.2.1",
    "openai": "^6.9.1",
    "react": "^18.3.1",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
